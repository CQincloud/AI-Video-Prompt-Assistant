# 应用配置
APP_NAME=SuperBizAgent
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=9900
DOCS_ENABLED=True
CORS_ALLOWED_ORIGINS=http://localhost:9900,http://127.0.0.1:9900

# 认证配置
AUTH_SECRET_KEY=change-me-in-production
AUTH_COOKIE_NAME=jucheng_session
AUTH_COOKIE_SECURE=False
AUTH_SESSION_TTL_HOURS=1
AUTH_TRUSTED_PROXY_IPS=127.0.0.1,::1
AUTH_LOGIN_ATTEMPT_LIMIT_PER_PHONE=5
AUTH_LOGIN_ATTEMPT_LIMIT_PER_IP=20
AUTH_LOGIN_ATTEMPT_WINDOW_MINUTES=10
AUTH_LOGIN_LOCKOUT_MINUTES=10

# 短信配置
SMS_PROVIDER=aliyun
SMS_MOCK_CODE=123456
SMS_CODE_LENGTH=6
SMS_CODE_TTL_MINUTES=5
SMS_RESEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_HOURLY_LIMIT_PER_IP=30
ALIYUN_SMS_SIGN_NAME=武汉炬成科技
ALIYUN_SMS_TEMPLATE_CODE=SMS_333837184
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_CONNECT_TIMEOUT_MS=3000
ALIYUN_SMS_READ_TIMEOUT_MS=10000
ALIYUN_SMS_MAX_ATTEMPTS=2
# 阿里云 RAM 用户 AccessKey，填入后会发送真实短信验证码：
# ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
# 也兼容直接在本应用中配置：
# ALIYUN_SMS_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_SMS_ACCESS_KEY_SECRET=your-access-key-secret

# PostgreSQL 配置
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=jucheng_ai_user
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_APPLICATION_NAME=super_biz_agent
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_POOL_ENABLED=True
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_MIGRATIONS_PATH=database/migrations
DATABASE_VALIDATE_MIGRATIONS_ON_STARTUP=True
DATABASE_AUTO_MIGRATE_ON_STARTUP=False
DATABASE_ALLOW_UNTRACKED_SCHEMA_ENSURE=False

# DashScope / AI 模型配置
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TASK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_VISION_MODEL=qwen-vl-plus
DASHSCOPE_IMAGE_GENERATION_MODEL=wanx2.1-t2i-turbo
DASHSCOPE_REQUEST_TIMEOUT_SECONDS=60
DASHSCOPE_CONNECT_TIMEOUT_SECONDS=10
DASHSCOPE_MAX_RETRIES=2

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
# Keep false outside disposable local development. True allows dropping and recreating
# the Milvus collection when the configured vector dimension changes.
MILVUS_ALLOW_DESTRUCTIVE_SCHEMA_RESET=False
